# lowmem.orum — hosted Orum tool: builds the Menagerie low-memory blob.
#
# The UEFI loader cannot rely on the BIOS loader (mkcustom.py, deleted
# Oct 23) to place the kernel's low-memory environment. This tool
# generates lowmem.bin: a single contiguous image covering 0x6000-0x7B88
# that the loader copies to 0x6000 before jumping to the kernel.
#
# Blob layout (offsets relative to blob start = 0x6000):
#   0x0000  ISR stubs, 256 x 16B: push imm8 vec; jmp rel32 common; 9x nop
#   0x1000  common ISR handler, 80B (handler_addr = 0 placeholder;
#           the LOADER patches it with on_irq's address at runtime,
#           at blob offset 0x1000+37, after scanning the kernel)
#   0x1100  font, 54 x 16B (864B, original glyphs)
#   0x1460  glyph index, 128B (ASCII -> glyph idx, 0xFF = none)
#   0x16B4  scancode table, 128B (PS/2 set 1 -> ASCII)
#   0x1734  shifted scancode table, 128B
#   0x17B4  NUL-terminated strings (~532B, addresses match kmain header)
#   0x1988  HID usage -> ASCII, 256B
#   0x1A88  shifted HID table, 256B
# Gaps (0x5000 IDT area excluded; 0x74E0-0x76B4 kernel state) are zeros;
# the kernel initializes its own state regions at runtime.
# Total blob size: 0x1B88 (7048 bytes).
#
# Data sources: font.orum (glyphs + index), mkcustom.py tables + strings
# (recovered from trash Oct 24; the Python is NOT restored, only its
# constants are ported here). ISR stub/handler byte patterns match
# mkcustom.py build_isr_block exactly.

take copy_bytes, wr32, zero_fill from common

OUT_BIN = "lowmem.bin"
BLOB_SIZE = 7048

fn lowmem_build(out_path: str)
img: raw *u8 = heap_alloc(7048)
zero_fill(img, 0, 7048)

# --- ISR stubs: 256 x 16B at blob + 0x0000 ---
mut v: u64 = 0
while v < 256
s: u64 = v * 16
img[s] = 0x6A
img[s + 1] = v & 0xFF
img[s + 2] = 0xE9
rel: u64 = 0x7000 - (0x6000 + s + 7)
wr32(img, s + 3, rel)
mut k: u64 = 7
while k < 16
img[s + k] = 0x90
k = k + 1
end
v = v + 1
end

# --- common handler: 80B at blob + 0x1000 (addr placeholder = 0) ---
handler: raw *u8 = [
  0x41, 0x57, 0x41, 0x56, 0x41, 0x55, 0x41, 0x54, 0x41, 0x53, 0x41, 0x52, 0x41, 0x51, 0x41, 0x50,
  0x50, 0x51, 0x52, 0x56, 0x57, 0x55, 0x53, 0x48, 0x8B, 0xBC, 0x24, 0x78, 0x00, 0x00, 0x00, 0x48,
  0x83, 0xEC, 0x08, 0x48, 0xB8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xFF, 0xD0, 0x48,
  0x83, 0xC4, 0x08, 0x5B, 0x5D, 0x5F, 0x5E, 0x5A, 0x59, 0x58, 0x41, 0x58, 0x41, 0x59, 0x41, 0x5A,
  0x41, 0x5B, 0x41, 0x5C, 0x41, 0x5D, 0x41, 0x5E, 0x41, 0x5F, 0x48, 0x83, 0xC4, 0x08, 0x48, 0xCF
]
copy_bytes(img, 4096, handler, 0, 80)

