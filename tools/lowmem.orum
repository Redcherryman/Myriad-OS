ofd: int = fopen(out_path, "w")
if ofd < 0
crash "cannot open lowmem output for writing"
end
mut wrote: u64 = 0
while wrote < 7048
n: int = fwrite(ofd, img + wrote, 7048 - wrote)
if n <= 0
crash "short write to lowmem output"
end
wrote = wrote + n
end
fclose(ofd)
say(7048)
end

# Standalone entry: fixed path.
lowmem_build(OUT_BIN)
